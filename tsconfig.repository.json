{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "checkJs": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noImplicitAny": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitReturns": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@rts/ai": ["packages/ai/src/index.ts"],
      "@rts/audio": ["packages/audio/src/index.ts"],
      "@rts/game-data": ["packages/game-data/src/index.ts"],
      "@rts/pathfinding": ["packages/pathfinding/src/index.ts"],
      "@rts/protocol": ["packages/protocol/src/index.ts"],
      "@rts/renderer": ["packages/renderer/src/index.ts"],
      "@rts/server": ["apps/server/src/index.ts"],
      "@rts/shared": ["packages/shared/src/index.ts"],
      "@rts/simulation": ["packages/simulation/src/index.ts"],
      "@rts/simulation/commands/schema.js": ["packages/simulation/src/commands/schema.ts"],
      "@rts/simulation/contracts": ["packages/simulation/src/contracts/index.ts"],
      "@rts/simulation/fixtures": ["packages/simulation/src/determinism-fixture.ts"],
      "@rts/simulation/systems/movement-step.js": ["packages/simulation/src/systems/movement-step.ts"]
    },
    "typeRoots": ["./apps/server/node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "*.cjs",
    "*.js",
    "*.jsx",
    "*.mjs",
    "*.ts",
    "*.tsx",
    "apps/**/*.cjs",
    "apps/**/*.js",
    "apps/**/*.jsx",
    "apps/**/*.mjs",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.cjs",
    "packages/**/*.js",
    "packages/**/*.jsx",
    "packages/**/*.mjs",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.js",
    "tests/**/*.jsx",
    "tests/**/*.mjs",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tools/**/*.cjs",
    "tools/**/*.js",
    "tools/**/*.jsx",
    "tools/**/*.mjs",
    "tools/**/*.ts",
    "tools/**/*.tsx"
  ],
  "exclude": [
    "apps/web/src/shared/ui/**",
    "**/dist/**",
    "node_modules/**",
    "tmp/**",
    "tools/assets/src/catalog/curated.ts"
  ]
}
