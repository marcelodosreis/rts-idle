{
  "name": "@rts/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "dev:instance": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@rts/game-data": "workspace:*",
    "@rts/simulation": "workspace:*",
    "@rts/protocol": "workspace:*",
    "@rts/ai": "workspace:*",
    "@rts/shared": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0"
  }
}
