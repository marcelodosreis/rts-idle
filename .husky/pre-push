#!/bin/sh

PROJECT_TOOLCHAIN_REQUIRE_PNPM=1 . "$(dirname "$0")/ensure-project-toolchain.sh"

while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo ""
      echo "❌ Push blocked: direct pushes to $(basename $remote_ref) are not allowed."
      echo "   Use a pull request instead."
      echo ""
      exit 1
      ;;
  esac
done

echo "🔍 Checking project types before push..."

corepack pnpm run typecheck
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Push blocked: TypeScript errors found."
  echo "   Fix the errors above before pushing."
  echo ""
  exit 1
fi

echo "✅ TypeScript check passed."

echo "🔍 Checking lint and architecture barriers before push..."

corepack pnpm run lint
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Push blocked: lint violations found (clean code / SOLID / typed strings)."
  echo "   Fix the errors above before pushing."
  echo ""
  exit 1
fi

corepack pnpm run test:architecture
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Push blocked: architecture or typed-domain barriers failed."
  echo "   Fix the errors above before pushing."
  echo ""
  exit 1
fi

echo "✅ Lint and architecture barriers passed."
